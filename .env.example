# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Server-only administrator login. NEVER prefix these with VITE_ and never commit real values.
# Generate the hash and secret locally with:  npm run admin:hash
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Supabase. The two VITE_ values are public (row-level security protects the data).
# SUPABASE_SERVICE_ROLE_KEY is a SERVER-ONLY secret used by /api/admin/*; never prefix it with VITE_.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Payments (Cashfree) - server-only secrets. Leave empty to keep payments simulated.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
SITE_URL=

# Fulfilment automation. COURIER=simulator uses a pretend courier (default in local development);
# leave empty in production until a real courier adapter is added (server/courier/).
COURIER=
SIM_STEP_SECONDS=45
# Required in production: the scheduler must send this in the x-automation-secret header on POST /api/v1/automation/tick
AUTOMATION_SECRET=
# Optional: how long one automation run may keep working (milliseconds). Defaults to 15000 on Vercel, 25000 elsewhere.
AUTOMATION_BUDGET_MS=
